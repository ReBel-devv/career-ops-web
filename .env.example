# Absolute path to your career-ops data repo (private/local mode).
CAREER_OPS_PATH=/absolute/path/to/career-ops

# Serve anonymized fixture data instead of the real repo.
# REQUIRED (=true) for any Vercel/public deployment — the build fails otherwise.
DEMO_MODE=false

# Belt-and-suspenders: disable every mutation even in local mode.
READ_ONLY=false

# Embedded Claude Agent SDK assistant (local only). Defaults to ON; set =false to
# hide it. Automatically forced OFF in demo mode, without CAREER_OPS_PATH, or on a
# public (Vercel) build. Requires a local Claude Code login or ANTHROPIC_API_KEY.
ASSISTANT_ENABLED=true
