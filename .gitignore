# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local carries the private repo path; only the example is committed
.env*
!.env.example

# test fixtures derived from real data, and parser modules copied from the
# data repo at test time (see tests/setup/copy-fixtures.ts)
/tests/fixtures/real/
/tests/fixtures/**/tracker-parse.mjs
/tests/fixtures/**/tracker-utils.mjs
/tests/fixtures/**/tracker-aliases.json

# vercel
.vercel

# playwright
/test-results/
/playwright-report/
/e2e/screenshots/

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored local design skill (not shared with the repo)
/.claude/skills/ui-ux-pro-max/

# in-app assistant: local-only plan + stored conversations (never shared)
/docs/ASSISTANT-PLAN.md
/.assistant/

# internal working notes — kept locally, not shared publicly
/docs/DASHBOARD-FIXES.md
/docs/DESIGN-REFRESH.md
/docs/HANDOFF.md
